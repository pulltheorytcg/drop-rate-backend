        "definition": "CREATE OR REPLACE FUNCTION tcg.current_user_id()\n RETURNS uuid\n LANGUAGE sql\n STABLE\n SET search_path TO 'pg_catalog'\nAS $function$\n    SELECT nullif(current_setting('tcg.user_id', true), '')::uuid\n$function$\n",
