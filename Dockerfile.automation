# Drop Rate n8n automation-event dispatcher.
# This service only delivers durable outbox events to a configured n8n webhook.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --requirement /app/requirements.txt

COPY backend /app/backend

# Fail the image build early if dispatcher code cannot compile.
RUN python -m py_compile \
    /app/backend/app/automation_dispatcher.py \
    /app/backend/scripts/run_automation_dispatcher.py

CMD ["python", "/app/backend/scripts/run_automation_dispatcher.py"]
