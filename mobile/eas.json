{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://drop-rate-api-live-production.up.railway.app",
        "EXPO_PUBLIC_LIVE_PREVIEW": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
