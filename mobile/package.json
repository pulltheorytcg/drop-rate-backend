{
  "name": "pulltheory-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "expo lint",
    "check": "npm run typecheck && npm run lint && npm test",
    "export": "expo export --platform all",
    "build:android": "npx eas-cli@24.8.0 build --platform android --profile preview",
    "build:ios": "npx eas-cli@24.8.0 build --platform ios --profile preview",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write src tests scripts *.json *.js",
    "native:android": "expo run:android",
    "native:ios": "expo run:ios",
    "build:ios:testflight": "npx eas-cli@24.8.0 build --platform ios --profile production",
    "submit:ios:testflight": "npx eas-cli@24.8.0 submit --platform ios --profile production"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
