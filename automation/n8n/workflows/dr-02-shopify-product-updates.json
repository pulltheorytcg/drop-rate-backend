{
  "id": "DR02ShopifyProductUpdatesV1",
  "name": "DR-02 Shopify Product Updates V1",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "DR90GlobalErrorV1"
  },
  "nodes": [
    {
      "id": "dr02-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -760,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "dr02-prepare",
      "name": "Prepare Product Update Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ],
      "parameters": {
        "jsCode": "const now = new Date();\nconst bucketMs = 15 * 60 * 1000;\nconst bucket = new Date(Math.floor(now.getTime() / bucketMs) * bucketMs).toISOString();\nconst executionId = String($execution.id || '').trim();\nif (!executionId) throw new Error('product_update_execution_id_missing');\nconst command = {\n  schema_version: 1,\n  execution_id: executionId,\n  idempotency_key: 'shopify-product-updates:v1:' + bucket,\n  occurred_at: now.toISOString(),\n  limit: 50,\n};\nreturn [{json:{command}}];"
      }
    },
    {
      "id": "dr02-sign",
      "name": "Sign Product Update Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst command = $json.command;\nconst secret = String($env.DROP_RATE_AUTOMATION_COMMAND_SECRET || '').trim();\nconst receiptUrl = String($env.DROP_RATE_API_AUTOMATION_CONTROL_URL || '').trim();\nif (secret.length < 32) throw new Error('automation_command_secret_not_configured');\nif (!/\\/automation\\/control\\/receipt$/.test(receiptUrl)) throw new Error('automation_control_receipt_url_invalid');\nconst body = JSON.stringify(command);\nconst timestamp = String(Math.floor(Date.now()/1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + body, 'utf8').digest('hex');\nconst commandUrl = receiptUrl.replace(/\\/automation\\/control\\/receipt$/, '/automation/commands/shopify/product-updates');\nreturn [{json:{command_url:commandUrl,command_body:body,command_timestamp:timestamp,command_signature:signature,command}}];"
      }
    },
    {
      "id": "dr02-http",
      "name": "Reconcile via FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.command_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Drop-Rate-Timestamp",
              "value": "={{ $json.command_timestamp }}"
            },
            {
              "name": "X-Drop-Rate-Signature",
              "value": "={{ $json.command_signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.command_body }}",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "dr02-verify",
      "name": "Update Batch Verified?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json || {};\nconst statusCode = Number(response.statusCode || 0);\nif (statusCode < 200 || statusCode >= 300) throw new Error('shopify_product_updates_http_' + statusCode);\nconst body = response.body || {};\nif (Number(body.failed_count || 0) !== 0) throw new Error('shopify_product_updates_failed');\nif (Number(body.retry_required_count || 0) !== 0) throw new Error('shopify_product_updates_retry_required');\nreturn [{json:{verified:true,result:body}}];"
      }
    },
    {
      "id": "dr02-receipt",
      "name": "Record Durable Success",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "DR91SuccessReceiptV1",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "workflow_key": "shopify-product-updates",
            "workflow_version": "v1",
            "execution_id": "={{ $execution.id }}",
            "idempotency_key": "={{ $('Prepare Product Update Command').item.json.command.idempotency_key }}",
            "occurred_at": "={{ $now.toISO() }}",
            "owner_id": "",
            "event_id": ""
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "workflow_key",
              "displayName": "workflow_key",
              "type": "string"
            },
            {
              "id": "workflow_version",
              "displayName": "workflow_version",
              "type": "string"
            },
            {
              "id": "execution_id",
              "displayName": "execution_id",
              "type": "string"
            },
            {
              "id": "idempotency_key",
              "displayName": "idempotency_key",
              "type": "string"
            },
            {
              "id": "occurred_at",
              "displayName": "occurred_at",
              "type": "string"
            },
            {
              "id": "owner_id",
              "displayName": "owner_id",
              "type": "string"
            },
            {
              "id": "event_id",
              "displayName": "event_id",
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Prepare Product Update Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Product Update Command": {
      "main": [
        [
          {
            "node": "Sign Product Update Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign Product Update Command": {
      "main": [
        [
          {
            "node": "Reconcile via FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reconcile via FastAPI": {
      "main": [
        [
          {
            "node": "Update Batch Verified?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Batch Verified?": {
      "main": [
        [
          {
            "node": "Record Durable Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "dropRate": {
      "contract": "DR-02",
      "version": 1,
      "role": "shopify-published-price-reconciliation",
      "activationGate": "Keep inactive until the DR-02 migration is applied, DR-90/DR-91 are published/proven, automated Shopify updates are deliberately enabled, and no-op/duplicate, stale-state, Shopify-failure and read-back tests pass in a controlled run."
    }
  }
}
