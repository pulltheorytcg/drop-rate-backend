{
  "id": "DR92WorkflowHeartbeatV1",
  "name": "DR-92 Workflow Heartbeat",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "DR90GlobalErrorV1"
  },
  "nodes": [
    {
      "id": "dr92-schedule",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -520,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "dr92-prepare",
      "name": "Prepare Heartbeat Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        0
      ],
      "parameters": {
        "jsCode": "const now = new Date();\\nconst bucketMs = 5 * 60 * 1000;\\nconst bucket = new Date(Math.floor(now.getTime() / bucketMs) * bucketMs).toISOString();\\nconst executionId = String($execution.id || '').trim();\\nif (!executionId) throw new Error('heartbeat_execution_id_missing');\\nreturn [{json:{\\n  workflow_key:'workflow-heartbeat',\\n  workflow_version:'v1',\\n  execution_id:executionId,\\n  idempotency_key:'n8n-heartbeat:' + bucket,\\n  occurred_at:now.toISOString(),\\n  owner_id:'',\\n  event_id:''\\n}}];"
      }
    },
    {
      "id": "dr92-receipt",
      "name": "Record Durable Heartbeat",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "DR91SuccessReceiptV1",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "workflow_key": "={{ $json.workflow_key }}",
            "workflow_version": "={{ $json.workflow_version }}",
            "execution_id": "={{ $json.execution_id }}",
            "idempotency_key": "={{ $json.idempotency_key }}",
            "occurred_at": "={{ $json.occurred_at }}",
            "owner_id": "={{ $json.owner_id }}",
            "event_id": "={{ $json.event_id }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "workflow_key",
              "displayName": "workflow_key",
              "type": "string"
            },
            {
              "id": "workflow_version",
              "displayName": "workflow_version",
              "type": "string"
            },
            {
              "id": "execution_id",
              "displayName": "execution_id",
              "type": "string"
            },
            {
              "id": "idempotency_key",
              "displayName": "idempotency_key",
              "type": "string"
            },
            {
              "id": "occurred_at",
              "displayName": "occurred_at",
              "type": "string"
            },
            {
              "id": "owner_id",
              "displayName": "owner_id",
              "type": "string"
            },
            {
              "id": "event_id",
              "displayName": "event_id",
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "dr92-verify",
      "name": "Heartbeat Receipt Recorded?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json || {};\\nif (result.recorded !== true || result.workflow_key !== 'workflow-heartbeat') {\\n  throw new Error('heartbeat_receipt_not_recorded');\\n}\\nreturn [{json:{healthy:true,workflow_key:result.workflow_key,execution_id:result.execution_id}}];"
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Prepare Heartbeat Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Heartbeat Receipt": {
      "main": [
        [
          {
            "node": "Record Durable Heartbeat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Durable Heartbeat": {
      "main": [
        [
          {
            "node": "Heartbeat Receipt Recorded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "dropRate": {
      "contract": "DR-92",
      "version": 1,
      "role": "workflow-heartbeat",
      "activationGate": "Keep inactive until DR-90 and DR-91 are published/proven. Publish DR-92, verify one durable heartbeat plus duplicate safety, then enable backend heartbeat alerting."
    }
  }
}
