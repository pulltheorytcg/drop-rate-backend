        }
      }
    },
    {
      "id": "dr00v2-unsupported",
      "name": "Unsupported Event",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        220,
        20
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: false, error: 'unsupported_event_type' } }}",
        "options": {
          "responseCode": 422
        }
      }
    },
    {
      "id": "dr00v2-rejected",
      "name": "Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        -40,
