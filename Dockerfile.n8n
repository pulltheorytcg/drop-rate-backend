FROM ghcr.io/n8n-io/n8n:2.32.6

USER root
COPY automation/n8n/workflows /opt/drop-rate/workflows
COPY automation/n8n/start.sh /opt/drop-rate/start.sh
RUN chmod 0555 /opt/drop-rate/start.sh \
    && find /opt/drop-rate/workflows -type f -name '*.json' -exec chmod 0444 {} \;
USER node

ENTRYPOINT ["/opt/drop-rate/start.sh"]
