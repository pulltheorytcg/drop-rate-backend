{% assign featured = section.settings.product %}
<section class="dr-editorial"><div class="dr-wrap dr-editorial__layout"><div><p class="dr-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="dr-btn" href="{{ section.settings.link }}">{{ section.settings.button | escape }} <span aria-hidden="true">↗</span></a></div><div class="dr-editorial__art"><span aria-hidden="true">✦</span>{% if featured.featured_image %}<a href="{{ featured.url }}" aria-label="{{ featured.title | escape }}">{{ featured.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width:749px) 180px, 260px', loading: 'lazy' }}</a><div class="dr-editorial__caption"><strong>{{ featured.title | split: ' · ' | first | escape }}</strong><span>{{ featured.price | money }}</span></div>{% endif %}</div></div></section>
{% stylesheet %}
.dr-editorial{background:#071b3f;color:#fff;margin-block:25px 0;overflow:hidden}.dr-editorial__layout{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:60px;min-height:410px;padding-block:45px}.dr-editorial .dr-eyebrow{color:#28d7eb;font-size:10px}.dr-editorial h2{color:#fff;font-size:clamp(36px,4.2vw,62px);max-width:580px;line-height:1.03;letter-spacing:-.05em;margin:0}.dr-editorial p:not(.dr-eyebrow){color:#c8d6ec;font-size:14px;line-height:1.7;max-width:390px;margin:23px 0 26px}.dr-editorial__art{position:relative;min-height:330px;text-align:center;isolation:isolate}.dr-editorial__art>span{font-family:serif;font-size:450px;line-height:1;position:absolute;top:-70px;left:calc(50% - 200px);color:#0d2a59;z-index:-1}.dr-editorial__art>a{display:block;height:290px;transform:rotate(8deg)}.dr-editorial__art img{height:100%;width:100%;object-fit:contain;filter:drop-shadow(0 18px 14px #0005)}.dr-editorial__caption{display:flex;gap:30px;justify-content:center;font-size:13px;margin-top:22px}.dr-editorial__caption span{color:#28d7eb}@media(max-width:749px){.dr-editorial__layout{grid-template-columns:1fr;gap:30px;padding-block:35px}.dr-editorial h2{font-size:39px}.dr-editorial__art{min-height:290px}.dr-editorial__art>a{height:255px}.dr-editorial__art>span{font-size:380px;left:calc(50% - 170px)}}
{% endstylesheet %}
{% schema %}
{"name":"Drop Rate spotlight","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The display case"},{"type":"text","id":"heading","label":"Heading","default":"Some cards deserve the spotlight."},{"type":"textarea","id":"description","label":"Description","default":"Explore graded cards and find a new centrepiece for your collection."},{"type":"text","id":"button","label":"Button","default":"Explore graded cards"},{"type":"url","id":"link","label":"Link"},{"type":"product","id":"product","label":"Featured product"}],"presets":[{"name":"Drop Rate spotlight"}]}
{% endschema %}
