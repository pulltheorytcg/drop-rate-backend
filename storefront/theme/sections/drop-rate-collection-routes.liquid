{% liquid
  assign h = collection.handle
  assign game = 'all'
  assign is_one_piece_set = false
  assign is_pokemon_set = false

  assign pokemon_sets = 'battle-partners|crimson-haze|future-flash|ruler-of-the-black-flame|shiny-treasure-ex|terastal-festival-ex' | split: '|'
  assign one_piece_sets = 'egghead-crisis|the-time-of-battle|the-azure-seas-seven|prb02-one-piece-card-the-best-vol-2|adventure-on-kamis-island|carrying-on-his-will|awakening-of-the-new-era|one-piece-promotion-cards-jp|paramount-war|prb01-one-piece-card-the-best' | split: '|'

  if h == 'pokemon' or h == 'pokemon-singles' or h == 'pokemon-graded-cards'
    assign game = 'pokemon'
  elsif h == 'one-piece' or h == 'one-piece-singles'
    assign game = 'one-piece'
  endif

  if pokemon_sets contains h
    assign game = 'pokemon'
    assign is_pokemon_set = true
  elsif one_piece_sets contains h
    assign game = 'one-piece'
    assign is_one_piece_set = true
  endif

  assign all_cards = collections['trading-cards']
  assign pokemon = collections['pokemon']
  assign one_piece = collections['one-piece']
  assign all_singles = collections['singles']
  assign all_graded = collections['graded-cards']
  assign all_sealed = collections['sealed']
%}

<nav class="dr-browse-nav" aria-label="{{ 'dr_brand.browse.aria' | t }}">
  <div class="dr-browse-nav__inner">
    <div class="dr-browse-nav__primary" aria-label="{{ 'dr_brand.browse.by_game' | t }}">
      {% if all_cards != blank and all_cards.all_products_count > 0 %}
        <a{% if h == 'trading-cards' %} aria-current="page"{% endif %} href="{{ all_cards.url }}">{{ 'dr_brand.browse.all_cards' | t }}</a>
      {% endif %}
      {% if pokemon != blank and pokemon.all_products_count > 0 %}
        <a{% if game == 'pokemon' and h == 'pokemon' %} aria-current="page"{% endif %} href="{{ pokemon.url }}">{{ 'dr_brand.browse.pokemon' | t }}</a>
      {% endif %}
      {% if one_piece != blank and one_piece.all_products_count > 0 %}
        <a{% if game == 'one-piece' and h == 'one-piece' %} aria-current="page"{% endif %} href="{{ one_piece.url }}">{{ 'dr_brand.browse.one_piece' | t }}</a>
      {% endif %}
      {% if all_singles != blank and all_singles.all_products_count > 0 %}
        <a{% if h == 'singles' %} aria-current="page"{% endif %} href="{{ all_singles.url }}">{{ 'dr_brand.browse.singles' | t }}</a>
      {% endif %}
      {% if all_graded != blank and all_graded.all_products_count > 0 %}
        <a{% if h == 'graded-cards' %} aria-current="page"{% endif %} href="{{ all_graded.url }}">{{ 'dr_brand.browse.graded' | t }}</a>
      {% endif %}
      {% if all_sealed != blank and all_sealed.all_products_count > 0 %}
        <a{% if h == 'sealed' %} aria-current="page"{% endif %} href="{{ all_sealed.url }}">{{ 'dr_brand.browse.sealed' | t }}</a>
      {% endif %}
    </div>

    {% if game == 'pokemon' %}
      {% assign pokemon_singles = collections['pokemon-singles'] %}
      {% assign pokemon_graded = collections['pokemon-graded-cards'] %}
      <div class="dr-browse-nav__secondary" aria-label="{{ 'dr_brand.browse.pokemon_label' | t }}">
        <span class="dr-browse-nav__label">{{ 'dr_brand.browse.pokemon' | t }}</span>
        {% if pokemon != blank and pokemon.all_products_count > 0 %}<a{% if h == 'pokemon' %} aria-current="page"{% endif %} href="{{ pokemon.url }}">{{ 'dr_brand.browse.all' | t }}</a>{% endif %}
        {% if pokemon_singles != blank and pokemon_singles.all_products_count > 0 %}<a{% if h == 'pokemon-singles' %} aria-current="page"{% endif %} href="{{ pokemon_singles.url }}">{{ 'dr_brand.browse.singles' | t }}</a>{% endif %}
        {% if pokemon_graded != blank and pokemon_graded.all_products_count > 0 %}<a{% if h == 'pokemon-graded-cards' %} aria-current="page"{% endif %} href="{{ pokemon_graded.url }}">{{ 'dr_brand.browse.graded' | t }}</a>{% endif %}
      </div>
      <div class="dr-browse-nav__sets" aria-label="{{ 'dr_brand.browse.pokemon_sets_label' | t }}">
        <span class="dr-browse-nav__label">{{ 'dr_brand.browse.sets' | t }}</span>
        {% for set_handle in pokemon_sets %}
          {% assign set_collection = collections[set_handle] %}
          {% if set_collection != blank and set_collection.all_products_count > 0 %}
            <a{% if h == set_handle %} aria-current="page"{% endif %} href="{{ set_collection.url }}">{{ set_collection.title | escape }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% elsif game == 'one-piece' %}
      {% assign one_piece_singles = collections['one-piece-singles'] %}
      <div class="dr-browse-nav__secondary" aria-label="{{ 'dr_brand.browse.one_piece_label' | t }}">
        <span class="dr-browse-nav__label">{{ 'dr_brand.browse.one_piece' | t }}</span>
        {% if one_piece != blank and one_piece.all_products_count > 0 %}<a{% if h == 'one-piece' %} aria-current="page"{% endif %} href="{{ one_piece.url }}">{{ 'dr_brand.browse.all' | t }}</a>{% endif %}
        {% if one_piece_singles != blank and one_piece_singles.all_products_count > 0 %}<a{% if h == 'one-piece-singles' %} aria-current="page"{% endif %} href="{{ one_piece_singles.url }}">{{ 'dr_brand.browse.singles' | t }}</a>{% endif %}
      </div>
      <div class="dr-browse-nav__sets" aria-label="{{ 'dr_brand.browse.one_piece_sets_label' | t }}">
        <span class="dr-browse-nav__label">{{ 'dr_brand.browse.sets' | t }}</span>
        {% for set_handle in one_piece_sets %}
          {% assign set_collection = collections[set_handle] %}
          {% if set_collection != blank and set_collection.all_products_count > 0 %}
            <a{% if h == set_handle %} aria-current="page"{% endif %} href="{{ set_collection.url }}">{{ set_collection.title | escape }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</nav>

{% stylesheet %}
.dr-browse-nav{border-bottom:1px solid #e2e8f0;background:#fff;box-shadow:0 8px 24px rgba(7,27,63,.035)}
.dr-browse-nav__inner{display:grid;width:min(100% - 80px,1400px);margin-inline:auto;padding-block:13px;gap:9px}
.dr-browse-nav__primary,.dr-browse-nav__secondary,.dr-browse-nav__sets{display:flex;align-items:center;gap:7px;overflow-x:auto;scrollbar-width:none}
.dr-browse-nav__primary::-webkit-scrollbar,.dr-browse-nav__secondary::-webkit-scrollbar,.dr-browse-nav__sets::-webkit-scrollbar{display:none}
.dr-browse-nav a{flex:0 0 auto;text-decoration:none;white-space:nowrap;transition:background 140ms ease,border-color 140ms ease,color 140ms ease,transform 140ms ease}
.dr-browse-nav__primary a{padding:9px 13px;border:1px solid #dce4ed;border-radius:999px;background:#f4f7fb;color:#13223b;font-size:11px;font-weight:750}
.dr-browse-nav__primary a:hover{border-color:#9bc4fb;background:#eef5ff;color:#0d5fcb;transform:translateY(-1px)}
.dr-browse-nav__primary a[aria-current="page"]{border-color:#071b3f;background:linear-gradient(135deg,#071b3f,#0d2a59);color:#fff;box-shadow:0 6px 16px rgba(7,27,63,.14)}
.dr-browse-nav__secondary,.dr-browse-nav__sets{padding-top:2px}
.dr-browse-nav__secondary a,.dr-browse-nav__sets a{padding:6px 9px;border-radius:999px;color:#6d7b91;font-size:10px;font-weight:700}
.dr-browse-nav__secondary a:hover,.dr-browse-nav__sets a:hover,.dr-browse-nav__secondary a[aria-current="page"],.dr-browse-nav__sets a[aria-current="page"]{background:#eafcff;color:#0b7080}
.dr-browse-nav__label{flex:0 0 auto;margin-right:3px;color:#8492a8;font-size:9px;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
@media(max-width:749px){
  .dr-browse-nav__inner{width:calc(100% - 32px);padding-block:10px;gap:7px}
  .dr-browse-nav__primary a{padding:8px 10px;font-size:10px}
  .dr-browse-nav__secondary a,.dr-browse-nav__sets a{padding:6px 8px;font-size:9px}
}
{% endstylesheet %}

{% schema %}
{"name":"DR collection routes","settings":[],"presets":[{"name":"DR collection routes"}]}
{% endschema %}
