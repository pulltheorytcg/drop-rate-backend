<section class="dr-mobile-sell-footer" aria-label="Sell with Drop Rate">
  <div class="dr-mobile-sell-footer__inner">
    <div class="dr-mobile-sell-footer__copy">
      <span>Seller Hub</span>
      <strong>Got cards to sell?</strong>
    </div>
    <a href="https://drop-rate-api-live-production.up.railway.app/owner/join" aria-label="Sell with Drop Rate">
      Sell With Us <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

{% stylesheet %}
  .dr-mobile-sell-footer {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .dr-mobile-sell-footer {
      display: block;
      padding: 0 16px 18px;
      background: #f4f7fb;
    }

    .dr-mobile-sell-footer__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 14px 15px;
      border: 1px solid #dbe5f1;
      border-radius: 12px;
      background: #ffffff;
      box-shadow: 0 8px 22px rgba(7, 27, 63, 0.05);
    }

    .dr-mobile-sell-footer__copy {
      display: grid;
      gap: 3px;
      min-width: 0;
    }

    .dr-mobile-sell-footer__copy span {
      color: #1f7bf2;
      font-size: 10px;
      font-weight: 850;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .dr-mobile-sell-footer__copy strong {
      color: #13223b;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.2;
    }

    .dr-mobile-sell-footer a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      flex: 0 0 auto;
      min-height: 38px;
      padding: 0 13px;
      border-radius: 999px;
      background: #1f7bf2;
      color: #ffffff;
      font-size: 12px;
      font-weight: 800;
      line-height: 1;
      text-decoration: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Drop Rate mobile sell link",
  "settings": [],
  "presets": [{"name":"Drop Rate mobile sell link"}]
}
{% endschema %}
