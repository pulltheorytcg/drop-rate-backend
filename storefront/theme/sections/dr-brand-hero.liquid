{% liquid
  assign feature = section.settings.featured_product
  assign left_card = section.settings.left_product
  assign right_card = section.settings.right_product
%}
<section class="dr-hero" aria-labelledby="dr-hero-{{ section.id }}">
  <div class="dr-wrap dr-hero__layout">
    <div class="dr-hero__copy">
      <p class="dr-eyebrow"><span class="dr-spark" aria-hidden="true">✦</span> {{ section.settings.eyebrow | escape }}</p>
      <h1 id="dr-hero-{{ section.id }}">{{ section.settings.heading | escape }}<br><em>{{ section.settings.highlight | escape }}</em></h1>
      <p class="dr-hero__intro">{{ section.settings.description | escape }}</p>
      <a class="dr-btn" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">{% render 'dr-arrow-up-right' %}</span></a>
      <a class="dr-text-link" href="{{ collections['graded-cards'].url }}">{{ 'dr_brand.hero.graded' | t }} <span aria-hidden="true">→</span></a>
      <p class="dr-hero__small">{{ 'dr_brand.hero.note' | t }}</p>
    </div>
    <div class="dr-hero__stage">
      <div class="dr-orbit" aria-hidden="true"><span>✦</span></div>
      <span class="dr-stage-label">{{ 'dr_brand.hero.stage' | t }}</span>
      {% if left_card.featured_image %}<a class="dr-fan dr-fan--left" href="{{ left_card.url }}" aria-label="{{ left_card.title | escape }}" data-dr-hero-card data-title="{{ left_card.title | split: ' · ' | first | escape }}" data-price="{{ left_card.price | money | escape }}">{{ left_card.featured_image | image_url: width: 500 | image_tag: widths: '250, 400, 500', sizes: '(max-width: 749px) 130px, 210px', loading: 'eager' }}</a>{% endif %}
      {% if right_card.featured_image %}<a class="dr-fan dr-fan--right" href="{{ right_card.url }}" aria-label="{{ right_card.title | escape }}" data-dr-hero-card data-title="{{ right_card.title | split: ' · ' | first | escape }}" data-price="{{ right_card.price | money | escape }}">{{ right_card.featured_image | image_url: width: 500 | image_tag: widths: '250, 400, 500', sizes: '(max-width: 749px) 130px, 210px', loading: 'eager' }}</a>{% endif %}
      {% if feature.featured_image %}
        <a class="dr-fan dr-fan--main" href="{{ feature.url }}" aria-label="{{ feature.title | escape }}" data-dr-hero-card data-title="{{ feature.title | split: ' · ' | first | escape }}" data-price="{{ feature.price | money | escape }}">{{ feature.featured_image | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(max-width: 749px) 180px, 265px', loading: 'eager', fetchpriority: 'high' }}</a>
        <a class="dr-feature-caption" href="{{ feature.url }}" data-dr-hero-caption><span><small>{{ 'dr_brand.hero.spotlight' | t }}</small><strong data-dr-hero-title>{{ feature.title | split: ' · ' | first | escape }}</strong></span><b><span data-dr-hero-price>{{ feature.price | money }}</span> <span aria-hidden="true">{% render 'dr-arrow-up-right' %}</span></b></a>
      {% endif %}
    </div>
  </div>
  <div class="dr-hero__baseline dr-wrap"><span>{{ 'dr_brand.trust.uk' | t }}</span><span>{{ 'dr_brand.trust.condition' | t }}</span><span>{{ 'dr_brand.trust.checkout' | t }}</span></div>
</section>
<script>
(() => {
  const root = document.getElementById('dr-hero-{{ section.id }}')?.closest('.dr-hero');
  if (!root) return;
  const stage = root.querySelector('.dr-hero__stage');
  const cards = Array.from(stage.querySelectorAll('[data-dr-hero-card]'));
  const caption = stage.querySelector('[data-dr-hero-caption]');
  const title = stage.querySelector('[data-dr-hero-title]');
  const price = stage.querySelector('[data-dr-hero-price]');
  if (cards.length < 2 || !caption) return;
  const positions = ['dr-fan--left','dr-fan--main','dr-fan--right'];
  let paused = false;
  const sync = () => {
    const active = cards.find(card => card.classList.contains('dr-fan--main'));
    if (!active) return;
    caption.href = active.href;
    if (title) title.textContent = active.dataset.title || active.getAttribute('aria-label') || '';
    if (price) price.textContent = active.dataset.price || '';
  };
  const rotateTo = (target) => {
    const current = cards.findIndex(card => card.classList.contains('dr-fan--main'));
    const next = cards.indexOf(target);
    if (current < 0 || next < 0 || current === next) return;
    const currentPos = cards.map(card => positions.find(p => card.classList.contains(p)));
    const targetPos = currentPos[next];
    const mainPos = currentPos[current];
    cards[current].classList.remove(mainPos);
    cards[current].classList.add(targetPos);
    cards[next].classList.remove(targetPos);
    cards[next].classList.add(mainPos);
    sync();
  };
  cards.forEach(card => card.addEventListener('click', (event) => {
    if (!card.classList.contains('dr-fan--main')) {
      event.preventDefault();
      paused = true;
      rotateTo(card);
    }
  }));
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.setInterval(() => {
      if (paused || document.hidden) return;
      const current = cards.findIndex(card => card.classList.contains('dr-fan--main'));
      rotateTo(cards[(current + 1) % cards.length]);
    }, 4800);
  }
  sync();
})();
</script>
{% stylesheet %}
.dr-wrap{width:min(100% - 80px,1400px);margin-inline:auto}.dr-eyebrow{font-size:11px;font-weight:750;text-transform:uppercase;letter-spacing:.16em;margin:0 0 22px;display:flex;align-items:center;gap:9px}.dr-spark{font-size:25px;color:#1f7bf2}.dr-hero{background:#f4f7fb;color:#071b3f;overflow:hidden}.dr-hero__layout{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:48px;padding-block:60px 40px}.dr-hero h1{font-size:clamp(48px,5.9vw,88px);font-weight:850;letter-spacing:-.065em;line-height:.98;margin:0;max-width:650px;text-wrap:balance}.dr-hero h1 em{font-style:normal;color:#1f7bf2;display:inline-block}.dr-hero__intro{font-size:17px;line-height:1.65;color:#6d7b91;max-width:410px;margin:25px 0 29px}.dr-btn{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;background:#1f7bf2;color:#fff;padding:17px 23px;border:1px solid #1f7bf2;border-radius:4px;font-weight:750;font-size:14px;text-decoration:none;transition:background .2s,transform .2s}.dr-btn:hover{background:#176bd9;transform:translateY(-2px)}.dr-text-link{font-weight:650;font-size:13px;margin-left:24px;text-underline-offset:6px}.dr-hero__small{font-size:11px;color:#6d7b91;margin-top:25px}.dr-hero__stage{height:430px;position:relative;isolation:isolate}.dr-orbit{position:absolute;inset:8% 7%;border:1px solid #dce4ed;border-radius:50%;transform:rotate(-22deg);background:radial-gradient(ellipse at 50% 50%,#eafcff 0,transparent 70%)}.dr-orbit:after{content:'';position:absolute;inset:28px -25px;border:1px solid #e2e8f0;border-radius:50%}.dr-orbit span{position:absolute;right:20px;top:-20px;font-size:70px;color:#28d7eb}.dr-stage-label{position:absolute;top:0;right:0;font-size:9px;letter-spacing:.2em;font-weight:700}.dr-fan{position:absolute;display:block;filter:drop-shadow(0 15px 13px #071b3f20);transition:transform .25s}.dr-fan img{width:100%;height:100%;object-fit:contain;border-radius:9px}.dr-fan--main{width:47%;height:85%;left:27%;top:1%;z-index:3;transform:rotate(3deg)}.dr-fan--left{width:36%;height:68%;left:2%;top:18%;transform:rotate(-16deg);z-index:1}.dr-fan--right{width:36%;height:68%;right:0;top:15%;transform:rotate(17deg);z-index:2}.dr-fan:hover{transform:rotate(0) translateY(-8px)}.dr-feature-caption{position:absolute;bottom:-5px;left:16%;right:0;z-index:4;display:flex;justify-content:space-between;align-items:center;gap:16px;background:#fff;padding:15px 20px;border:1px solid #e2e8f0;box-shadow:0 10px 20px #071b3f07;text-decoration:none;border-radius:5px}.dr-feature-caption small{display:block;color:#6d7b91;font-size:9px;text-transform:uppercase;letter-spacing:.15em;margin-bottom:5px}.dr-feature-caption strong{font-size:15px}.dr-feature-caption b{font-size:14px;white-space:nowrap}.dr-feature-caption b span{margin-left:15px;color:#1f7bf2}.dr-hero__baseline{display:flex;gap:36px;border-top:1px solid #e2e8f0;padding-block:19px;font-size:11px;font-weight:650}.dr-hero__baseline span:before{content:'✓';color:#1f7bf2;margin-right:8px}@media(max-width:989px){.dr-wrap{width:calc(100% - 40px)}.dr-hero__layout{gap:20px}.dr-hero__stage{height:350px}.dr-text-link{display:inline-block;margin:20px 0 0 18px}}@media(max-width:749px){.dr-wrap{width:calc(100% - 32px)}.dr-hero__layout{grid-template-columns:1fr;gap:25px;padding-block:32px 25px}.dr-eyebrow{font-size:9px;margin-bottom:16px}.dr-hero h1{font-size:54px;max-width:440px}.dr-hero__intro{font-size:14px;margin:18px 0 22px;max-width:330px}.dr-hero__small{margin-top:17px}.dr-hero__stage{height:330px;width:100%;max-width:420px;margin:auto}.dr-feature-caption{left:6%;padding:12px 14px}.dr-hero__baseline{gap:12px;justify-content:space-between;font-size:9px;padding-block:15px}.dr-hero__baseline span{max-width:30%}.dr-hero__baseline span:before{display:none}.dr-stage-label{font-size:8px}.dr-btn{padding:15px 18px;font-size:13px}.dr-text-link{font-size:12px;margin-top:0}.dr-hero__stage .dr-fan--main{height:84%}}@media(prefers-reduced-motion:reduce){.dr-btn,.dr-fan{transition:none}.dr-btn:hover,.dr-fan:hover{transform:none}}
{% endstylesheet %}
{% schema %}
{"name":"Drop Rate brand hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"For the thrill of the find"},{"type":"text","id":"heading","label":"Heading","default":"Your next"},{"type":"text","id":"highlight","label":"Highlight","default":"great drop."},{"type":"textarea","id":"description","label":"Description","default":"The binder favourite. The deck upgrade. The one you've been chasing. Find it at Drop Rate."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the cards"},{"type":"url","id":"link","label":"Button link"},{"type":"product","id":"featured_product","label":"Centre card"},{"type":"product","id":"left_product","label":"Left card"},{"type":"product","id":"right_product","label":"Right card"}],"presets":[{"name":"Drop Rate brand hero"}]}
{% endschema %}
