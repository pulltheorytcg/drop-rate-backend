<section class="dr-sets dr-wrap"><div class="dr-section-heading"><div><p class="dr-eyebrow">{{ 'dr_brand.sets.eyebrow' | t }}</p><h2>{{ 'dr_brand.sets.title' | t }}</h2></div></div><div class="dr-set-grid">{% for block in section.blocks %}{% assign c = block.settings.collection %}{% if c != blank %}<a href="{{ c.url }}" {{ block.shopify_attributes }}><span>{{ block.settings.code | escape }}</span><strong>{{ c.title | escape }}</strong><b aria-hidden="true">{% render 'dr-arrow-up-right' %}</b></a>{% endif %}{% endfor %}</div><div class="dr-help"><span class="dr-help__star" aria-hidden="true">✦</span><div><h2>{{ 'dr_brand.help.title' | t }}</h2><p>{{ 'dr_brand.help.text' | t }}</p></div><a href="{{ pages['contact'].url | default: '/pages/contact' }}">{{ 'dr_brand.help.link' | t }} <span aria-hidden="true">→</span></a></div></section>
{% stylesheet %}
.dr-sets{padding-block:55px 0}.dr-set-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #e2e8f0;border-left:1px solid #e2e8f0}.dr-set-grid a{display:grid;grid-template-columns:1fr auto;gap:13px;padding:24px;border-right:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;text-decoration:none;transition:background .2s}.dr-set-grid a:hover{background:#eef5ff}.dr-set-grid span{grid-column:1/-1;color:#1f7bf2;font-size:10px;letter-spacing:.15em;font-weight:750}.dr-set-grid strong{font-size:16px;line-height:1.35;letter-spacing:-.02em}.dr-set-grid b{color:#1f7bf2;font-size:22px}.dr-help{display:flex;align-items:center;gap:26px;margin-top:55px;padding:32px 0;border-top:1px solid #e2e8f0}.dr-help__star{font-size:65px;color:#28d7eb;line-height:1}.dr-help h2{font-size:23px;letter-spacing:-.03em;margin:0 0 7px}.dr-help p{font-size:12px;color:#6d7b91;margin:0}.dr-help a{margin-left:auto;font-size:12px;font-weight:700;text-underline-offset:5px;white-space:nowrap}@media(max-width:749px){.dr-sets{padding-top:35px}.dr-set-grid{grid-template-columns:1fr 1fr}.dr-set-grid a{padding:18px 14px}.dr-set-grid strong{font-size:14px}.dr-help{flex-wrap:wrap;gap:15px;margin-top:35px;padding-block:25px}.dr-help__star{font-size:42px}.dr-help>div{flex:1}.dr-help h2{font-size:20px}.dr-help p{font-size:11px}.dr-help a{margin-left:57px}.dr-set-grid span{font-size:9px}}
{% endstylesheet %}
{% schema %}
{"name":"Drop Rate set discovery","settings":[],"blocks":[{"type":"set","name":"Set","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"code","label":"Set code"}]}],"presets":[{"name":"Drop Rate set discovery"}]}
{% endschema %}
