<section class="dr-discover dr-wrap" aria-labelledby="dr-discover-{{ section.id }}">
  <form class="dr-find" action="{{ routes.search_url }}" method="get" role="search"><label for="dr-find-{{ section.id }}">{{ 'dr_brand.search.label' | t }}</label><div><input id="dr-find-{{ section.id }}" name="q" type="search" placeholder="{{ 'dr_brand.search.placeholder' | t }}" required><input name="type" value="product" type="hidden"><input name="options[prefix]" value="last" type="hidden"><button type="submit" aria-label="{{ 'dr_brand.search.submit' | t }}">↗</button></div></form>
  <div class="dr-section-heading"><div><p class="dr-eyebrow">{{ 'dr_brand.discovery.eyebrow' | t }}</p><h2 id="dr-discover-{{ section.id }}">{{ 'dr_brand.discovery.title' | t }}</h2></div><a href="{{ routes.collections_url }}">{{ 'dr_brand.discovery.all' | t }} <span aria-hidden="true">→</span></a></div>
  <div class="dr-game-grid">
    {% for block in section.blocks %}{% assign c = block.settings.collection %}{% assign p = block.settings.product %}{% if c != blank %}
    <a href="{{ c.url }}" class="dr-game dr-game--{{ block.settings.tone }}" {{ block.shopify_attributes }}><span class="dr-game__copy"><small>{{ block.settings.eyebrow | escape }}</small><strong>{{ c.title | escape }}</strong><span>{{ block.settings.label | escape }} <b aria-hidden="true">↗</b></span></span>{% if p.featured_image %}{{ p.featured_image | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '(max-width:749px) 110px, 155px', loading: 'lazy' }}{% endif %}<span class="dr-game__symbol" aria-hidden="true">✦</span></a>
    {% endif %}{% endfor %}
  </div>
</section>
{% stylesheet %}
.dr-discover{padding-block:35px 50px}.dr-find{display:grid;grid-template-columns:1fr 2.3fr;gap:30px;align-items:center;padding-bottom:37px;margin-bottom:37px;border-bottom:1px solid #e2e8f0}.dr-find label{font-size:19px;font-weight:700;letter-spacing:-.03em}.dr-find>div{display:flex;border:1px solid #dce4ed;background:#fff;border-radius:4px;overflow:hidden}.dr-find input[type=search]{width:100%;border:0;background:transparent;color:#071b3f;padding:16px 20px;font-size:13px;outline-offset:-3px}.dr-find button{border:0;background:#071b3f;color:#fff;width:58px;flex-shrink:0;font-size:25px;cursor:pointer}.dr-section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px;padding-inline-start:12px;box-sizing:border-box}.dr-section-heading h2{font-size:clamp(28px,3vw,42px);letter-spacing:-.05em;line-height:1.06;margin:0}.dr-section-heading .dr-eyebrow{margin-bottom:10px;color:#6d7b91;font-size:9px}.dr-section-heading>a{font-size:12px;font-weight:650;text-underline-offset:5px}.dr-game-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.dr-game{position:relative;min-height:230px;overflow:hidden;border-radius:5px;display:flex;align-items:center;text-decoration:none;padding:30px}.dr-game--aqua{background:#eafcff}.dr-game--navy{background:#071b3f;color:#fff}.dr-game__copy{display:grid;gap:14px;position:relative;z-index:2}.dr-game__copy small{font-size:10px;letter-spacing:.15em;text-transform:uppercase}.dr-game__copy strong{font-size:37px;letter-spacing:-.04em;line-height:1.1}.dr-game__copy>span{font-size:12px;margin-top:18px;font-weight:650}.dr-game__copy b{padding-left:30px}.dr-game img{position:absolute;right:7%;top:24px;width:29%;height:230px;object-fit:contain;transform:rotate(13deg);filter:drop-shadow(0 8px 10px #0002);z-index:1;transition:transform .25s}.dr-game:hover img{transform:rotate(8deg) translateY(-5px)}.dr-game__symbol{position:absolute;right:19%;top:-56px;font-size:320px;color:#fff5;font-family:serif;font-weight:400;line-height:1}.dr-game--navy .dr-game__symbol{color:#0d2a59}@media(max-width:749px){.dr-section-heading{padding-inline-start:4px}.dr-discover{padding-block:25px 35px}.dr-find{grid-template-columns:1fr;gap:13px;padding-bottom:25px;margin-bottom:28px}.dr-find label{font-size:17px}.dr-find input[type=search]{font-size:12px;padding:15px}.dr-game-grid{grid-template-columns:1fr;gap:12px}.dr-game{min-height:178px;padding:23px}.dr-game__copy strong{font-size:30px}.dr-game img{height:185px;top:16px;right:8%;width:30%}.dr-game__copy{gap:8px}.dr-game__copy>span{margin-top:12px}.dr-section-heading h2{font-size:29px}.dr-section-heading>a{font-size:10px;white-space:nowrap}.dr-game__symbol{top:-80px}}@media(prefers-reduced-motion:reduce){.dr-game img{transition:none}.dr-game:hover img{transform:rotate(13deg)}}
{% endstylesheet %}
{% schema %}
{"name":"Drop Rate discovery","settings":[],"blocks":[{"type":"game","name":"Game","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"product","id":"product","label":"Card image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your next favourite"},{"type":"text","id":"label","label":"Link label","default":"Explore the collection"},{"type":"select","id":"tone","label":"Colour","options":[{"value":"aqua","label":"Turquoise"},{"value":"navy","label":"Navy"}],"default":"aqua"}]}],"presets":[{"name":"Drop Rate discovery"}]}
{% endschema %}
