<section class="dr-collection-intro"><div class="dr-wrap"><nav class="dr-breadcrumb" aria-label="{{ 'dr_brand.nav.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'dr_brand.nav.home' | t }}</a><span aria-hidden="true">/</span><span>{{ collection.title | escape }}</span></nav><div class="dr-collection-intro__row"><div><p class="dr-eyebrow">{{ 'dr_brand.collection.eyebrow' | t }}</p><h1>{{ collection.title | escape }}<span aria-hidden="true">.</span></h1><p class="dr-collection-intro__count">{{ collection.all_products_count }} {% if collection.all_products_count == 1 %}{{ 'dr_brand.collection.card' | t }}{% else %}{{ 'dr_brand.collection.cards' | t }}{% endif %}</p>{% if collection.description != blank %}<div class="dr-collection-intro__description">{{ collection.description }}</div>{% else %}<p>{{ 'dr_brand.collection.description' | t }}</p>{% endif %}</div><span class="dr-collection-intro__star" aria-hidden="true">✦</span></div></div></section>
{% stylesheet %}
.dr-collection-intro{
  position:relative;
  isolation:isolate;
  overflow:hidden;
  padding-block:28px 42px;
  border-bottom:1px solid rgba(255,255,255,.08);
  background:
    radial-gradient(circle at 84% 12%,rgba(40,215,235,.18),transparent 19rem),
    radial-gradient(circle at 15% 115%,rgba(31,123,242,.2),transparent 24rem),
    linear-gradient(142deg,#061733 0%,#08234d 58%,#0a3764 100%);
  color:#fff;
}
.dr-collection-intro::after{
  content:"";
  position:absolute;
  inset:0;
  z-index:-1;
  opacity:.12;
  pointer-events:none;
  background-image:radial-gradient(circle,rgba(255,255,255,.75) 1px,transparent 1px);
  background-size:24px 24px;
  mask-image:linear-gradient(120deg,transparent 18%,#000 76%);
}
.dr-collection-intro .dr-wrap{position:relative;z-index:1;width:min(100% - 80px,1400px);margin-inline:auto}
.dr-breadcrumb{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:30px;color:#8fa9ca;font-size:10px;font-weight:650}
.dr-breadcrumb a{color:#c8d6ec;text-decoration:none}
.dr-breadcrumb a:hover{color:#fff}
.dr-collection-intro__row{display:flex;align-items:center;justify-content:space-between;gap:28px}
.dr-collection-intro h1{margin:0;color:#fff;font-size:clamp(38px,5vw,66px);font-weight:850;letter-spacing:-.06em;line-height:1.02}
.dr-collection-intro h1>span{color:#28d7eb}
.dr-collection-intro .dr-eyebrow{margin-bottom:12px;color:#55dfea;font-size:9px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}
.dr-collection-intro__count{display:inline-flex;margin:14px 0 0!important;padding:6px 9px;border:1px solid rgba(40,215,235,.28);border-radius:999px;background:rgba(40,215,235,.1);color:#8ef0fa!important;font-size:10px!important;font-weight:800;letter-spacing:.05em}
.dr-collection-intro__description,.dr-collection-intro p:not(.dr-eyebrow):not(.dr-collection-intro__count){max-width:700px;margin-top:16px;color:#c8d6ec;font-size:13px;line-height:1.65}
.dr-collection-intro__star{padding:0 20px;color:rgba(40,215,235,.3);font-size:118px;line-height:.8;text-shadow:0 0 36px rgba(40,215,235,.16)}
.dr-breadcrumb,.dr-collection-intro__row>div:first-child{padding-inline-start:12px;box-sizing:border-box}
@media(max-width:749px){
  .dr-collection-intro .dr-wrap{width:calc(100% - 32px)}
  .dr-breadcrumb,.dr-collection-intro__row>div:first-child{padding-inline-start:4px}
  .dr-collection-intro{padding-block:22px 30px}
  .dr-breadcrumb{margin-bottom:22px}
  .dr-collection-intro__row{align-items:flex-end;gap:12px}
  .dr-collection-intro h1{font-size:40px}
  .dr-collection-intro__star{padding:0 0 3px 8px;font-size:54px}
  .dr-collection-intro__description{font-size:12px}
}
{% endstylesheet %}
{% schema %}
{"name":"Drop Rate collection","settings":[]}
{% endschema %}