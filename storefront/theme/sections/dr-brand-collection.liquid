<section class="dr-collection-intro"><div class="dr-wrap"><nav class="dr-breadcrumb" aria-label="{{ 'dr_brand.nav.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'dr_brand.nav.home' | t }}</a><span aria-hidden="true">/</span><span>{{ collection.title | escape }}</span></nav><div class="dr-collection-intro__row"><div><p class="dr-eyebrow">{{ 'dr_brand.collection.eyebrow' | t }}</p><h1>{{ collection.title | escape }}<span aria-hidden="true">.</span></h1><p class="dr-collection-intro__count">{{ collection.all_products_count }} {% if collection.all_products_count == 1 %}card{% else %}cards{% endif %}</p>{% if collection.description != blank %}<div class="dr-collection-intro__description">{{ collection.description }}</div>{% else %}<p>{{ 'dr_brand.collection.description' | t }}</p>{% endif %}</div><span class="dr-collection-intro__star" aria-hidden="true">✦</span></div></div></section>
{% stylesheet %}
.dr-collection-intro{background:#f4f7f7;border-bottom:1px solid #dfe5e8;padding-block:23px 37px}.dr-breadcrumb{display:flex;flex-wrap:wrap;gap:12px;font-size:10px;color:#607082;margin-bottom:32px}.dr-breadcrumb a{text-decoration:none}.dr-collection-intro__row{display:flex;justify-content:space-between;align-items:center}.dr-collection-intro h1{font-size:clamp(36px,5vw,64px);letter-spacing:-.06em;line-height:1.08;margin:0}.dr-collection-intro h1>span{color:#008693}.dr-collection-intro .dr-eyebrow{color:#007c89;font-size:9px;margin-bottom:12px}.dr-collection-intro__count{display:inline-flex;margin:12px 0 0!important;padding:5px 8px;border-radius:3px;background:#e8f7f6;color:#006f7a!important;font-size:10px!important;font-weight:750;letter-spacing:.05em}.dr-collection-intro__description,.dr-collection-intro p:not(.dr-eyebrow):not(.dr-collection-intro__count){font-size:13px;line-height:1.65;color:#536477;max-width:700px;margin-top:16px}.dr-collection-intro__star{color:#09c7d1;font-size:116px;line-height:1;padding:0 20px}.dr-collection-routes{background:#fff!important;border-color:#e0e7ec!important}.dr-collection-routes__inner{width:min(100% - 80px,1400px)!important;padding-block:19px!important}.dr-collection-routes a{background:#f4f7f7!important;border:1px solid #e0e7ec!important;border-radius:3px!important;font-size:11px!important}.dr-collection-routes a[aria-current]{background:#061d3b!important;color:white!important}@media(max-width:749px){.dr-collection-intro{padding-block:20px 25px}.dr-breadcrumb{margin-bottom:24px}.dr-collection-intro__star{font-size:54px;padding:0 0 0 10px}.dr-collection-intro h1{font-size:38px}.dr-collection-intro__description{font-size:12px}.dr-collection-routes__inner{width:calc(100% - 32px)!important}}
{% endstylesheet %}
{% schema %}
{"name":"Drop Rate collection","settings":[]}
{% endschema %}