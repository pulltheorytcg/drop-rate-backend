{% doc %}
  Renders the decorative diagonal arrow used by Drop Rate storefront links.
  @example
  {% render 'dr-arrow-up-right' %}
{% enddoc %}

<svg class="dr-arrow-up-right" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  <path d="M3.5 12.5 12.5 3.5M4 3.5h8.5V12" />
</svg>

{% stylesheet %}
  .dr-arrow-up-right {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.125em;
    flex-shrink: 0;
  }
{% endstylesheet %}
