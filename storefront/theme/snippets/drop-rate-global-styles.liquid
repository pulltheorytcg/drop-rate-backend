{% doc %}
Global refinements for the Drop Rate storefront.
{% enddoc %}

{% stylesheet %}
  .dr-product-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 2px;
  }

  .dr-product-meta__chip {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 3px 7px;
    border: 1px solid #b9e5e6;
    border-radius: 999px;
    background: #ddf4f3;
    color: #10263a;
    font-size: 0.68rem;
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
  }

  .product-grid .product-card {
    background: #ffffff;
    border-color: #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgb(7 27 63 / 6%);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  @media (hover: hover) {
    .product-grid .product-card:hover {
      transform: translateY(-2px);
      border-color: #bdd5f6;
      box-shadow: 0 14px 34px rgb(7 27 63 / 11%);
    }
  }

  .dr-card-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .dr-card-copy__game {
    color: #1f7bf2;
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .dr-card-copy__title {
    color: #13223b;
    text-decoration: none;
  }

  .dr-card-copy__title h3 {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #13223b;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.22;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .dr-card-copy p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #6d7b91;
    font-size: 0.69rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .dr-pdp-heading {
    display: grid;
    gap: 5px;
  }

  .dr-pdp-heading .dr-eyebrow {
    margin: 0;
    color: #1f7bf2;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .dr-pdp-heading h1 {
    margin: 0;
    color: #13223b;
    font-size: clamp(2rem, 3.4vw, 3.35rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .dr-pdp-heading > p:last-child {
    margin: 3px 0 0;
    color: #6d7b91;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .dr-pdp-summary {
    display: grid;
    gap: 14px;
    padding: 14px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(7,27,63,.055);
  }

  .dr-pdp-stock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    color: #13223b;
    font-size: 0.8rem;
    font-weight: 750;
  }

  .dr-pdp-stock > span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.85;
  }

  .dr-pdp-stock:not(.dr-pdp-stock--out) > span {
    color: #0f9a64;
    box-shadow: 0 0 0 4px rgba(15,154,100,.09);
  }

  .dr-pdp-stock--out {
    opacity: 0.55;
  }

  .dr-pdp-facts {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #f8fafc;
  }

  .dr-pdp-facts > div {
    display: grid;
    gap: 3px;
    padding: 11px 12px;
    border-bottom: 1px solid #e2e8f0;
  }

  .dr-pdp-facts > div:nth-child(odd) {
    border-right: 1px solid #e2e8f0;
  }

  .dr-pdp-facts span {
    color: #8492a8;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dr-pdp-facts strong {
    color: #13223b;
    font-size: 0.82rem;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  .dr-pdp-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 14px;
    color: #6d7b91;
    font-size: 0.72rem;
    font-weight: 650;
  }

  .dr-pdp-trust span::before {
    content: "✓";
    margin-right: 5px;
    color: #1f7bf2;
    font-weight: 900;
  }

  .dr-pdp-inventory {
    margin: 0;
    color: #94a0b2;
    font-size: 0.64rem;
    overflow-wrap: anywhere;
  }

  .dr-purchase-note {
    display: grid;
    gap: 3px;
    padding: 11px 13px;
    border-left: 3px solid #28d7eb;
    border-radius: 9px;
    background: #eafcff;
    color: #13223b;
    font-size: .76rem;
    line-height: 1.4;
  }

  .dr-purchase-note strong {
    font-size: .8rem;
  }

  .dr-purchase-note span {
    color: #6d7b91;
  }

  .dr-pdp-description {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #ffffff;
  }

  .dr-pdp-description summary {
    padding: 11px 13px;
    color: #13223b;
    font-size: .78rem;
    font-weight: 800;
    cursor: pointer;
  }

  .dr-pdp-description .rte {
    padding: 0 13px 13px;
    color: #59677d;
    font-size: .76rem;
    line-height: 1.55;
  }

  .dr-pdp-policies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }

  .dr-pdp-policies a {
    color: #1f7bf2;
    font-size: .72rem;
    font-weight: 750;
    text-decoration: none;
  }

  .dr-pdp-policies a:hover {
    text-decoration: underline;
  }

  .cart-page__more-blocks {
    margin-top: 18px;
  }

  @media screen and (max-width: 749px) {
    .dr-pdp-heading h1 { font-size: 2.15rem; }
    .dr-pdp-summary { padding: 12px; }
    .dr-pdp-facts { grid-template-columns: 1fr; }
    .dr-pdp-facts > div:nth-child(odd) { border-right: 0; }
  }

  /* .dr-facets-polish-marker */
  div.facets-block-wrapper--vertical {
    align-self: start;
    padding: 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgb(7 27 63 / 5%);
  }

  .facets--filters-title,
  .products-count-wrapper {
    color: #10263a;
  }

  .facets--horizontal.facets-controls-wrapper {
    padding-block: 10px;
    border-bottom: 1px solid #e2e8f0;
  }

  .facets-toggle {
    background: #ffffff;
    border-block: 1px solid #e2e8f0;
  }

  .facets-toggle__button {
    min-height: 40px;
    padding-inline: 14px;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    color: #071b3f;
    background: #ffffff;
    font-weight: 700;
  }

  theme-drawer#filters-drawer .theme-drawer__dialog {
    background: #ffffff;
    color: #13223b;
  }

  theme-drawer#filters-drawer .facets__drawer-actions {
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
  }

  @media screen and (max-width: 749px) {
    .facets-toggle {
      padding-inline: 12px;
    }
  }

  /* .dr-copy-selector-marker */
  .dr-copy-selector {
    display: grid;
    gap: 12px;
    padding: 14px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(7,27,63,.045);
  }

  .dr-copy-selector__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .dr-copy-selector__eyebrow,
  .dr-copy-selector__from,
  .dr-copy-selector__note {
    margin: 0;
  }

  .dr-copy-selector__eyebrow {
    color: #1f7bf2;
    font-size: .64rem;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .dr-copy-selector h2 {
    margin: 2px 0 0;
    color: #13223b;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .dr-copy-selector__from {
    color: #0d5fcb;
    font-size: .76rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .dr-copy-selector__list {
    display: grid;
    gap: 7px;
  }

  .dr-copy-option {
    display: grid;
    grid-template-columns: 46px minmax(0,1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 58px;
    padding: 7px 9px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
    color: #13223b;
    text-decoration: none;
    transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease, background 140ms ease;
  }

  .dr-copy-option:hover {
    border-color: #9bc4fb;
    background: #ffffff;
    box-shadow: 0 7px 20px rgba(7,27,63,.075);
    transform: translateY(-1px);
  }

  .dr-copy-option--current {
    border-color: #1f7bf2;
    background: #eef5ff;
    box-shadow: inset 0 0 0 1px #1f7bf2;
  }

  .dr-copy-option__media {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    overflow: hidden;
    border-radius: 6px;
    background: #f4f7fb;
  }

  .dr-copy-option__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dr-copy-option__body {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .dr-copy-option__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 8px;
    color: #6d7b91;
    font-size: .72rem;
  }

  .dr-copy-option__meta strong {
    color: #13223b;
    font-weight: 800;
  }

  .dr-copy-option__price {
    color: #13223b;
    font-size: .86rem;
    font-weight: 850;
  }

  .dr-copy-option__action {
    color: #1f7bf2;
    font-size: .68rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .dr-copy-selector__note {
    color: #8492a8;
    font-size: .68rem;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .dr-copy-selector { padding: 12px; }
    .dr-copy-selector__heading { align-items: start; }
    .dr-copy-option { grid-template-columns: 42px minmax(0,1fr); }
    .dr-copy-option__media { width: 42px; height: 42px; }
    .dr-copy-option__action {
      grid-column: 2;
      justify-self: start;
    }
  }

  .cart__checkout-button {
    border-color: #1f7bf2 !important;
    border-radius: 10px;
    background: #1f7bf2 !important;
    color: #ffffff !important;
    font-weight: 800;
    box-shadow: 0 9px 22px rgba(31,123,242,.18);
  }

  @media (hover: hover) {
    .cart__checkout-button:hover {
      border-color: #176bd9 !important;
      background: #176bd9 !important;
    }
  }

{% endstylesheet %}
