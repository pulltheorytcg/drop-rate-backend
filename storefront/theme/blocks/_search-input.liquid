

<script
  src="{{ 'search-page-input.js' | asset_url }}"
  defer
  type="module"
></script>

<form
  action="{{ routes.search_url }}"
  method="get"
  role="search"
  class="search-page-input__parent"
>
  <search-page-input-component
    style="
      {% render 'size-style', settings: block.settings %}
      {% render 'spacing-style', settings: block.settings %}
      {% if block.settings.input_style == 'custom' %}
        {% render 'input-custom-styles', block_settings: block.settings %}
        --style-border-width-inputs: {{ block.settings.border_width }}px;
        --style-border-radius-inputs: {{ block.settings.border_radius }}px;
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    <label
      for="SearchPageInput--{{ block.id }}"
      class="visually-hidden"
    >
      {{ 'dr_brand.search.label' | t }}
    </label>
    <span class="svg-wrapper search__icon">
      {{ 'icon-search.svg' | inline_asset_content }}
    </span>
    <input
      name="type"
      value="product"
      type="hidden"
    >
    <input
      name="options[prefix]"
      value="last"
      type="hidden"
    >
    <input
      name="options[unavailable_products]"
      value="last"
      type="hidden"
    >
    <input
      class="search-page-input"
      id="SearchPageInput--{{ block.id }}"
      type="search"
      name="q"
      ref="searchPageInput"
      on:keydown="/handleKeyDown"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'dr_brand.search.placeholder' | t }}"
    >
    <a
      href="{{ routes.search_url }}?type=product&q="
      class="search__reset-button"
      aria-label="{{ 'accessibility.reset_search' | t }}"
    >
      <span class="svg-wrapper search__reset-button-icon">
        {{ 'icon-reset.svg' | inline_asset_content }}
      </span>
      <span class="search__reset-button-text">
        {{ 'actions.clear' | t }}
      </span>
    </a>
  </search-page-input-component>
  <p class="dr-search-help">{{ 'dr_brand.search.help' | t }}</p>

  {% if search.results.size == 0 and search.terms != blank %}
    <div class="search-results__no-results">
      <p>
        {{ 'content.search_results_no_results_check_spelling' | t: terms: search.terms }}
      </p>
    </div>
  {% endif %}
</form>

{% stylesheet %}
  .search-page-input__parent {
    display: flex;
    flex-direction: column;
    align-items: var(--horizontal-alignment);
  }

  search-page-input-component {
    position: relative;
    top: 0;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: var(--size-style-width);
    margin: var(--margin-2xl) 0 var(--margin-md);
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(7,27,63,.055);
  }

  .search-page-input {
    width: 100%;
    min-height: 56px;
    padding-block: 14px;
    padding-inline: calc(var(--icon-size-lg) + var(--margin-xl) * 1.5);
    overflow: hidden;
    border: 1px solid #dce4ed;
    border-radius: 14px;
    background: #ffffff;
    color: #13223b;
    font-size: .95rem;
    font-weight: 650;
    text-overflow: ellipsis;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }

  .search-page-input:focus {
    outline: none;
    border-color: #8bb9f8;
    box-shadow: 0 0 0 4px rgba(31,123,242,.09);
  }

  .search-page-input::placeholder {
    color: #8492a8;
  }

  .dr-search-help {
    width: min(100%,46rem);
    margin: 0;
    color: #6d7b91;
    font-size: .76rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .search-results__no-results {
    width: min(100%,46rem);
    margin-top: 16px;
    padding: 12px 14px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #ffffff;
    color: #59677d;
    font-size: .8rem;
  }

  search-page-input-component .search__icon,
  search-page-input-component .search__icon:hover,
  search-page-input-component .search__reset-button,
  search-page-input-component .search__reset-button:hover {
    position: absolute;
    top: auto;
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
    background: transparent;
  }

  search-page-input-component .search__icon {
    inset-inline-start: var(--margin-lg);
    color: #1f7bf2;
  }

  search-page-input-component .search__icon svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    color: #1f7bf2;
  }

  search-page-input-component .search__reset-button {
    inset-inline-end: var(--margin-lg);
    border-radius: 100%;
    color: #6d7b91;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--animation-speed) var(--animation-easing),
      visibility var(--animation-speed) var(--animation-easing);
  }

  search-page-input-component .search__reset-button svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  search-page-input-component:has(.search-page-input:not(:placeholder-shown)) .search__reset-button {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  search-page-input-component .search__reset-button-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
    vertical-align: middle;
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  search-page-input-component .search__reset-button:active .search__reset-button-icon {
    transform: scale(.9);
  }

  search-page-input-component .search__reset-button--hidden {
    cursor: default;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  search-page-input-component .search__reset-button-text {
    display: none;
  }

  @media screen and (max-width:749px) {
    search-page-input-component { max-width: 100%; }
    .search-page-input {
      min-height: 52px;
      padding-inline: calc(var(--margin-xs) + var(--icon-size-lg) + var(--padding-md));
      font-size: .9rem;
    }
    search-page-input-component .search__icon { inset-inline-start: var(--margin-md); }
    search-page-input-component .search__reset-button { inset-inline-end: var(--margin-md); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search_input",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "t:content.input"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_input_field_in_theme_settings"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    }
  ],
  "presets": []
}
{% endschema %}
