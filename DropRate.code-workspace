{
  "folders": [
    {
      "name": "Drop Rate",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.expo": true
    },
    "typescript.tsdk": "mobile/node_modules/typescript/lib"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Drop Rate: open iPhone project",
        "type": "process",
        "command": "open",
        "args": [
          "${workspaceFolder}/native/ios/DropRate.xcodeproj"
        ],
        "problemMatcher": []
      },
      {
        "label": "Drop Rate: check native app",
        "type": "shell",
        "command": "./scripts/check.sh",
        "options": {
          "cwd": "${workspaceFolder}/native"
        },
        "problemMatcher": [],
        "group": "test"
      },
      {
        "label": "Drop Rate: build Android APK",
        "type": "shell",
        "command": "./gradlew assembleDebug",
        "options": {
          "cwd": "${workspaceFolder}/native/android"
        },
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "Drop Rate: open live hub",
        "type": "process",
        "command": "open",
        "args": [
          "https://app.droprate.co.uk/app"
        ],
        "problemMatcher": []
      }
    ]
  }
}
