{
  "folders": [
    {
      "name": "Drop Rate",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.expo": true
    },
    "typescript.tsdk": "mobile/node_modules/typescript/lib"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Drop Rate: start mobile",
        "type": "shell",
        "command": "npm start",
        "options": {
          "cwd": "${workspaceFolder}/mobile"
        },
        "problemMatcher": [],
        "isBackground": true
      },
      {
        "label": "Drop Rate: check app",
        "type": "shell",
        "command": "npm run check",
        "options": {
          "cwd": "${workspaceFolder}/mobile"
        },
        "problemMatcher": [],
        "group": "test"
      },
      {
        "label": "Drop Rate: browser preview",
        "type": "shell",
        "command": "npm run export && npm run preview",
        "options": {
          "cwd": "${workspaceFolder}/mobile"
        },
        "problemMatcher": [],
        "isBackground": true
      }
    ]
  }
}
